# Lightweight image that runs Kysely migrations and exits.
# Used as an init container before the app starts.
FROM oven/bun:1.4.3-alpine@sha256:629e17411f1f129dbec3af78d5af9c9f2a937435c80349437206c6b0b7422373 AS base
WORKDIR /app

COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production --ignore-scripts --omit=peer && \
    rm -rf node_modules/@types

COPY migrations/ ./migrations/
COPY src/services/database/ ./src/services/database/

USER bun

CMD ["bun", "run", "--bun", "migrations/migrate.ts"]
