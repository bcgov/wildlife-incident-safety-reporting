# Bulk-load image for the historical incidents CSV. Triggered as a Helm post-install Job.
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS base
WORKDIR /app

RUN apk add --no-cache postgresql-client

COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --production --ignore-scripts --omit=peer && \
    rm -rf node_modules/@types

COPY scripts/ ./scripts/
COPY src/services/database/ ./src/services/database/

USER bun

CMD ["bun", "run", "--bun", "scripts/seed.ts"]
